# ------------------------------------------------------------------------------
# Flutter & Dart
# ------------------------------------------------------------------------------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.flutter-plugins-gen/
.packages
.pub-cache/
.pub/
build/
coverage/
.metadata           # Flutter version-tracking file (auto-generated)
.fvm/               # FVM (Flutter Version Management) folder
# Generated registrants
**/generated_plugin_registrant.dart
lib/generated_plugin_registrant.dart

# ------------------------------------------------------------------------------
# Android
# ------------------------------------------------------------------------------
**/.gradle/
android/.gradle/
android/**/build/
android/**/captures/
android/**/outputs/
android/local.properties
**/*.keystore
**/*.jks
**/key.properties

# Optional: comment out if you intentionally commit Firebase configs
# android/app/google-services.json

# ------------------------------------------------------------------------------
# iOS / Xcode
# ------------------------------------------------------------------------------
ios/Pods/
ios/.symlinks/
ios/build/
ios/Flutter/ephemeral/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Runner/GeneratedPluginRegistrant.*
ios/Runner.xcodeproj/project.xcworkspace/
ios/Runner.xcodeproj/xcuserdata/
ios/Runner.xcworkspace/xcuserdata/
**/DerivedData/
**/*.pbxuser
**/*.mode1v3
**/*.mode2v3
**/*.perspectivev3
**/*.xcuserstate
**/*.xcscmblueprint

# Optional: comment out if you intentionally commit Firebase configs
# ios/Runner/GoogleService-Info.plist

# ------------------------------------------------------------------------------
# IDEs & Editors
# ------------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws

# VS Code – uncomment the next line if you want to exclude launch/tasks
# .vscode/

# ------------------------------------------------------------------------------
# Fastlane
# ------------------------------------------------------------------------------
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# ------------------------------------------------------------------------------
# Logs & temporary files
# ------------------------------------------------------------------------------
*.log
*.class
*.pyc
*.swp
*.swo
*~
.DS_Store
.atom/
.buildlog/
.history
.svn/

# ------------------------------------------------------------------------------
# Symbolication / obfuscation
# ------------------------------------------------------------------------------
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# Misc tool caches
# ------------------------------------------------------------------------------
.cache/

# ------------------------------------------------------------------------------
# Exceptions to above rules
# ------------------------------------------------------------------------------
!/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages